<?xml version="1.0" encoding="utf-8"?>
<!-- Stylized speed gauge (issue #51). One coherent instrument: a 260-degree dial
     with a red redline zone, a nine-position scale (majors on the quarters, minors
     between), a tapered needle parked mid-swing in the working range, and a ring
     hub the needle pivots on. Palette comes from res/values/colors.xml, the same
     cyan / amber / red the app HUD paints with.

     The geometry is generated and measured by scripts/preview_icon.py (run it
     with 'paths' and 'check'): everything stays inside
     the 66 dp guaranteed-visible circle of the adaptive canvas, the redline joins
     the cyan arc at one shared endpoint, the needle's pivot sits inside the hub
     ring and the scale ticks never touch it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Dial: cyan working range, then the redline segment -->
    <path
        android:strokeColor="@color/hud_cyan"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M31.02,73.28 A30,30 0 1 1 83.89,56.61" />
    <path
        android:strokeColor="@color/hud_red"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M83.89,56.61 A30,30 0 0 1 76.98,73.28" />
    <!-- Scale: majors at the quarter bearings, minors between them; the two inside
         the redline zone are red so the zone reads as a zone -->
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="2.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M34.08,70.71 L39.45,66.21" />
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="1.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M28.22,57.39 L32.19,56.87" />
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="2.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M30.44,43.01 L36.78,45.97" />
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="1.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M40.03,32.07 L42.18,35.45" />
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="2.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M54,28 L54,35" />
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="1.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M67.97,32.07 L65.82,35.45" />
    <path android:strokeColor="@color/hud_cyan" android:strokeWidth="2.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M77.56,43.01 L71.22,45.97" />
    <path android:strokeColor="@color/hud_red" android:strokeWidth="1.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M79.78,57.39 L75.81,56.87" />
    <path android:strokeColor="@color/hud_red" android:strokeWidth="2.5" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M73.92,70.71 L68.55,66.21" />
    <!-- Needle: tapered, wide end on the pivot, short counterweight tail -->
    <path
        android:fillColor="@color/hud_amber"
        android:pathData="M57.31,48.61 L70.09,40.50 L59.88,51.68 L55.53,52.71 Z" />
    <!-- Hub ring, drawn over the needle so the pivot reads clean -->
    <path
        android:strokeColor="@color/hud_cyan"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M54,47.5 A6.5,6.5 0 1 1 54,60.5 A6.5,6.5 0 1 1 54,47.5 Z" />
</vector>
