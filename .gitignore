hardware/drc-report.txt
hardware/scripts/tmp/
hardware/~*.lck
hardware/nets-report.md

# Local-only design/reference artefacts + graphify corpus config.
# NOTE: graphify is configured to ignore .gitignore (graphify-out/.graphify_build.json
# -> "gitignore": false) so these reference assets stay IN the knowledge graph even
# though they are never committed. Corpus exclusions live in .graphifyignore instead.
# Any new .gitignore entry that must also stay out of the graph needs a .graphifyignore twin.
.graphifyignore
.migration/
hardware/.history/
hardware/screenshots/
Screenshots/

# Throwaway analysis / scaffolding dirs - local only, regenerable. Matches at any
# level: ./scratch (DRC + geometry investigation) and hardware/scratch (the B.Cu
# 3D-mirroring A/B scaffolding).
scratch/

# scratch boards / renders from the frame probe (scripts/probe_frame.py)
hardware/probe_*
hardware/_probe/
hardware/board_*.png
hardware/crop_*.png
hardware/check_*.png

# Third-party tools installed locally (AGENTS rule 1 approval, 2026-10-17):
#   hardware/tools/freerouting/freerouting-cli.exe - Freerouting v2.5.0 native
#   Windows x64 CLI (sha256 verified against the release's checksums.txt, kept
#   beside it).  49 MB binary, regenerable by downloading the release; used only
#   as the external yardstick in step 5 of the stackup plan, never in the
#   generation pipeline.
hardware/tools/
